// ============================================================
// Cloudflare Worker برای سایت حریم پارس
// ============================================================

// محتوای HTML سایت (برای جلوگیری از مشکلات، به‌صورت رشته)
// یا می‌توانید فایل HTML را از R2 یا KV ذخیره کنید

async function handleRequest(request) {
  const url = new URL(request.url);
  const path = url.pathname;

  // ===== مسیرهای API =====
  if (path === '/api/articles') {
    return handleArticles(request);
  }

  // ===== مسیرهای فایل‌های استاتیک =====
  if (path === '/articles.json') {
    return fetchArticlesJSON();
  }

  // ===== مسیر اصلی =====
  if (path === '/' || path === '/index.html') {
    return serveHTML();
  }

  // ===== مسیرهای Assets (تصاویر، CSS و ...) =====
  // اگر تصاویر در Worker ذخیره شده‌اند
  if (path.startsWith('/assets/')) {
    // می‌توانید از R2 یا KV برای ذخیره فایل‌ها استفاده کنید
    // یا به‌صورت مستقیم از CDN لود کنید
    return new Response('Asset not found', { status: 404 });
  }

  // ===== 404 =====
  return new Response('صفحه مورد نظر یافت نشد', { status: 404 });
}

